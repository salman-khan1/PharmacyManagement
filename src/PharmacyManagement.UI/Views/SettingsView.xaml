<UserControl x:Class="PharmacyManagement.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Settings" FontSize="28" FontWeight="Bold" 
                  Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,20"/>

        <!-- Settings Cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pharmacy Info -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" 
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                   CornerRadius="8" Padding="20" Margin="0,0,15,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Pharmacy Information" FontSize="16" FontWeight="SemiBold" 
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Pharmacy Name" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding PharmacyName}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Address" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding PharmacyAddress}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,10">
                        <TextBlock Text="Phone" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding PharmacyPhone}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,15">
                        <TextBlock Text="Email" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding PharmacyEmail}" Height="30"/>
                    </StackPanel>

                    <Button Grid.Row="5" Content="Save Changes" Style="{DynamicResource PrimaryButtonStyle}" 
                           Command="{Binding SaveSettingsCommand}" Height="35" Width="150"/>
                </Grid>
            </Border>

            <!-- Application Settings -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" 
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                   CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Application Settings" FontSize="16" FontWeight="SemiBold" 
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

                    <!-- Theme Toggle -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dark Theme" VerticalAlignment="Center" 
                                  Foreground="{DynamicResource ForegroundBrush}"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsDarkTheme}" 
                                     Command="{Binding ToggleThemeCommand}"
                                     Style="{DynamicResource ToggleButtonStyle}" Width="50" Height="25"/>
                    </Grid>

                    <!-- Database Info -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Database Path" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap" 
                                  Foreground="{DynamicResource ForegroundBrush}" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <TextBlock Text="Log File Path" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding LogFilePath}" TextWrapping="Wrap" 
                                  Foreground="{DynamicResource ForegroundBrush}" FontSize="13"/>
                    </StackPanel>

                    <Button Grid.Row="4" Content="Open Log Folder" Style="{DynamicResource SecondaryButtonStyle}" 
                           Command="{Binding OpenLogFolderCommand}" Height="35" Width="150" Margin="0,0,0,10"/>

                    <!-- Version Info -->
                    <TextBlock Grid.Row="5" Text="Version 1.0.0" Foreground="{DynamicResource SecondaryForegroundBrush}" 
                              FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>

        <!-- About -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" 
               BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
               CornerRadius="8" Padding="20" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" 
                          Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Pharmacy Management System" FontSize="14" FontWeight="SemiBold" 
                          Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,5"/>
                <TextBlock Text="A complete pharmacy management solution for medicine inventory, sales, and reporting." 
                          TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Features: Medicine Management, Inventory Control, Point of Sale, Reports &amp; Analytics, Multi-user Support" 
                          TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
