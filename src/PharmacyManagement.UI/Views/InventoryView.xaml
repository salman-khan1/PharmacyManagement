<UserControl x:Class="PharmacyManagement.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Inventory Management" FontSize="28" FontWeight="Bold" 
                      Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

            <!-- Stock Operations Panel -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" 
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                   CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Stock Operations" FontSize="16" FontWeight="SemiBold" 
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Quantity" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding StockQuantity}" Height="30"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Unit Price" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding UnitPrice}" Height="30"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="Reason" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding TransactionReason}" Height="30"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,0,0">
                            <TextBlock Text="Reference #" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding ReferenceNumber}" Height="30"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="Stock In" Style="{DynamicResource SuccessButtonStyle}" 
                               Command="{Binding StockInCommand}" 
                               CommandParameter="{Binding SelectedMedicine}" 
                               Height="35" Width="100" Margin="0,0,10,0"/>
                        <Button Content="Stock Out" Style="{DynamicResource WarningButtonStyle}" 
                               Command="{Binding StockOutCommand}" 
                               CommandParameter="{Binding SelectedMedicine}" 
                               Height="35" Width="100" Margin="0,0,10,0"/>
                        <Button Content="Adjust" Style="{DynamicResource PrimaryButtonStyle}" 
                               Command="{Binding AdjustStockCommand}" 
                               CommandParameter="{Binding SelectedMedicine}" 
                               Height="35" Width="100" Margin="0,0,10,0"/>
                        <Button Content="Damaged" Style="{DynamicResource DangerButtonStyle}" 
                               Command="{Binding MarkDamagedCommand}" 
                               CommandParameter="{Binding SelectedMedicine}" 
                               Height="35" Width="100" Margin="0,0,10,0"/>
                        <Button Content="Return" Style="{DynamicResource SecondaryButtonStyle}" 
                               Command="{Binding ReturnStockCommand}" 
                               CommandParameter="{Binding SelectedMedicine}" 
                               Height="35" Width="100"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Alerts Section -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Low Stock -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" 
                       BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" 
                       CornerRadius="8" Padding="15" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Low Stock Items" FontWeight="SemiBold" 
                                  Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding LowStockItems.Count}" FontSize="24" FontWeight="Bold" 
                                  Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Expiring Soon -->
                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" 
                       BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" 
                       CornerRadius="8" Padding="15" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Expiring Soon" FontWeight="SemiBold" 
                                  Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding ExpiringItems.Count}" FontSize="24" FontWeight="Bold" 
                                  Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Expired -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" 
                       BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" 
                       CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Expired Items" FontWeight="SemiBold" 
                                  Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding ExpiredItems.Count}" FontSize="24" FontWeight="Bold" 
                                  Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Low Stock Items Detail -->
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" 
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                   CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Low Stock Details" FontSize="16" FontWeight="SemiBold" 
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding LowStockItems}" 
                             SelectedItem="{Binding SelectedMedicine}"
                             AutoGenerateColumns="False" IsReadOnly="True" 
                             Background="Transparent" BorderThickness="0"
                             HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                             RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="*"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="Minimum" Binding="{Binding MinimumQuantity}" Width="80"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=C}" Width="100"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Transaction History -->
            <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" 
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                   CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="250"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Recent Transactions" FontSize="16" FontWeight="SemiBold" 
                                  Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,15,0"/>
                        <Button Content="Refresh" Style="{DynamicResource SmallPrimaryButtonStyle}" 
                               Command="{Binding RefreshCommand}" Height="25" Width="70"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentTransactions}" 
                             AutoGenerateColumns="False" IsReadOnly="True" 
                             Background="Transparent" BorderThickness="0"
                             HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                             RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=g}" Width="150"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="120"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat=C}" Width="100"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
