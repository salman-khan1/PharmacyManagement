<UserControl x:Class="PharmacyManagement.UI.Views.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PharmacyManagement.UI.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:enums="clr-namespace:PharmacyManagement.Domain.Enums;assembly=PharmacyManagement.Domain">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Search & Results -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Point of Sale" FontSize="28" FontWeight="Bold" 
                      Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

            <!-- Barcode Scan -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding BarcodeText, UpdateSourceTrigger=PropertyChanged}" 
                        Height="40" FontSize="14"
                        Background="{DynamicResource InputBackgroundBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Padding="10,0" VerticalContentAlignment="Center"
                        Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ScanBarcodeCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Content="Scan" Style="{DynamicResource PrimaryButtonStyle}" 
                       Command="{Binding ScanBarcodeCommand}" Height="40" Width="80"/>
            </Grid>

            <!-- Search -->
            <Grid Grid.Row="2" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                        Height="35" FontSize="13"
                        Background="{DynamicResource InputBackgroundBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Padding="10,0" VerticalContentAlignment="Center"
                        Margin="0,0,10,0"/>
                <Button Grid.Column="1" Content="Search" Style="{DynamicResource PrimaryButtonStyle}" 
                       Command="{Binding SearchMedicineCommand}" Height="35" Width="80"/>
            </Grid>

            <!-- Search Results -->
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" 
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                   CornerRadius="8" Padding="10">
                <DataGrid ItemsSource="{Binding SearchResults}" 
                         AutoGenerateColumns="False" IsReadOnly="True" 
                         Background="Transparent" BorderThickness="0"
                         HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                         RowBackground="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding MedicineName}" Width="*"/>
                        <DataGridTextColumn Header="Generic" Binding="{Binding GenericName}" Width="*"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Quantity}" Width="70"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=C}" Width="80"/>
                        <DataGridTemplateColumn Header="Action" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+" Style="{DynamicResource SmallSuccessButtonStyle}" 
                                           Command="{Binding DataContext.AddToCartFromSearchCommand, 
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}" Width="30" Height="25"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Right Panel - Cart & Checkout -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Customer Info -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,5,2"/>
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding CustomerName}" Height="30" Margin="0,0,5,0"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Phone:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,2"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomerPhone}" Height="30"/>
            </Grid>

            <!-- Cart Header -->
            <TextBlock Grid.Row="1" Text="Shopping Cart" FontSize="16" FontWeight="SemiBold" 
                      Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>

            <!-- Cart Items -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" 
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                   CornerRadius="8" Padding="10" Margin="0,0,0,10">
                <DataGrid ItemsSource="{Binding CartItems}" 
                         AutoGenerateColumns="False" 
                         Background="Transparent" BorderThickness="0"
                         HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                         RowBackground="Transparent" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding MedicineName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=C}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="70" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="" Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="x" Style="{DynamicResource SmallDangerButtonStyle}" 
                                           Command="{Binding DataContext.RemoveFromCartCommand, 
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}" Width="25" Height="22" FontSize="10"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Totals -->
            <Grid Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" 
                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                 CornerRadius="8" Padding="15" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Sub Total:" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubTotal, StringFormat=C}" 
                          Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Discount:" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountAmount, StringFormat=C}" 
                          Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tax (5%):" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TaxAmount, StringFormat:C}" 
                          Foreground="{DynamicResource ForegroundBrush}" HorizontalAlignment="Right"/>

                <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="TOTAL:" FontSize="18" FontWeight="Bold" 
                          Foreground="{DynamicResource PrimaryBrush}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalAmount, StringFormat=C}" 
                          FontSize="18" FontWeight="Bold" 
                          Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right"/>

                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Disc %:" VerticalAlignment="Center" Margin="0,0,5,0" 
                              Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <TextBox Text="{Binding DiscountRate}" Width="50" Height="25" Margin="0,0,15,0"/>

                    <TextBlock Text="Paid:" VerticalAlignment="Center" Margin="0,0,5,0" 
                              Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <TextBox Text="{Binding AmountPaid}" Width="80" Height="25" Margin="0,0,10,0"/>

                    <TextBlock Text="Change:" VerticalAlignment="Center" Margin="0,0,5,0" 
                              Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <TextBlock Text="{Binding ChangeAmount, StringFormat=C}" VerticalAlignment="Center" 
                              FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Action Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Clear Cart" Style="{DynamicResource DangerButtonStyle}" 
                       Command="{Binding ClearCartCommand}" Height="45" Margin="0,0,10,0"/>
                <Button Grid.Column="1" Content="CHECKOUT" Style="{DynamicResource SuccessButtonStyle}" 
                       Command="{Binding CheckoutCommand}" Height="45" FontSize="16" FontWeight="Bold"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
