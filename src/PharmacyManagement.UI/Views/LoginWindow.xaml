<Window x:Class="PharmacyManagement.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pharmacy Management - Login"
        Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Height="120">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="PHARMACY MANAGEMENT" 
                          FontSize="24" FontWeight="Bold" 
                          Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="System" FontSize="16" 
                          Foreground="{DynamicResource AccentBrush}" 
                          HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Login Form -->
        <StackPanel Grid.Row="1" Margin="40,30,40,30" VerticalAlignment="Center">
            <TextBlock Text="Welcome" FontSize="20" FontWeight="SemiBold" 
                      Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,20"/>

            <TextBlock Text="Username" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                    Height="40" FontSize="14"
                    Background="{DynamicResource InputBackgroundBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Padding="10,5" Margin="0,0,0,15"/>

            <TextBlock Text="Password" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="40" FontSize="14"
                        Background="{DynamicResource InputBackgroundBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Padding="10,5" Margin="0,0,0,25"/>

            <Button Content="Login" Height="45" FontSize="16" FontWeight="SemiBold"
                   Background="{DynamicResource PrimaryBrush}" Foreground="White"
                   BorderThickness="0" Cursor="Hand"
                   Command="{Binding LoginCommand}"
                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Text="Default: admin / admin123" 
                      Foreground="{DynamicResource SecondaryForegroundBrush}"
                      HorizontalAlignment="Center" Margin="0,15,0,0" FontSize="12"/>

            <TextBlock Text="pharmacist / pharma123" 
                      Foreground="{DynamicResource SecondaryForegroundBrush}"
                      HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="12"/>

            <TextBlock Text="{Binding ErrorMessage}" 
                      Foreground="{DynamicResource ErrorBrush}"
                      TextWrapping="Wrap"
                      HorizontalAlignment="Center" Margin="0,15,0,0" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
