<UserControl x:Class="PharmacyManagement.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Reports" FontSize="28" FontWeight="Bold" 
                      Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

            <!-- Report Buttons -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
                <Button Content="Daily Sales" Style="{DynamicResource PrimaryButtonStyle}" 
                       Command="{Binding GenerateDailySalesReportCommand}" Height="45" Margin="0,0,10,10"/>
                <Button Content="Monthly Sales" Style="{DynamicResource PrimaryButtonStyle}" 
                       Command="{Binding GenerateMonthlySalesReportCommand}" Height="45" Margin="0,0,10,10"/>
                <Button Content="Inventory Report" Style="{DynamicResource PrimaryButtonStyle}" 
                       Command="{Binding GenerateInventoryReportCommand}" Height="45" Margin="0,0,0,10"/>
                <Button Content="Expiry Report" Style="{DynamicResource PrimaryButtonStyle}" 
                       Command="{Binding GenerateExpiryReportCommand}" Height="45" Margin="0,0,10,10"/>
                <Button Content="Supplier Report" Style="{DynamicResource PrimaryButtonStyle}" 
                       Command="{Binding GenerateSupplierReportCommand}" Height="45" Margin="0,0,10,10"/>
                <Button Content="Profit Report" Style="{DynamicResource PrimaryButtonStyle}" 
                       Command="{Binding GenerateProfitReportCommand}" Height="45" Margin="0,0,0,10"/>
            </UniformGrid>

            <!-- Sales Report -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" 
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                   CornerRadius="8" Padding="20" Margin="0,0,0,15"
                   Visibility="{Binding SalesReport, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sales Report" FontSize="18" FontWeight="SemiBold" 
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Total Invoices" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding SalesReport.TotalInvoices}" FontSize="20" FontWeight="Bold" 
                                      Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,15,0">
                            <TextBlock Text="Total Sales" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding SalesReport.TotalSales, StringFormat=C}" FontSize="20" FontWeight="Bold" 
                                      Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,15,0">
                            <TextBlock Text="Total Tax" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding SalesReport.TotalTax, StringFormat:C}" FontSize="20" FontWeight="Bold" 
                                      Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Total Discount" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding SalesReport.TotalDiscount, StringFormat:C}" FontSize="20" FontWeight="Bold" 
                                      Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Export Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="Export Excel" Style="{DynamicResource SmallSuccessButtonStyle}" 
                               Command="{Binding ExportToExcelCommand}" Height="30" Width="100" Margin="0,0,10,0"/>
                        <Button Content="Export CSV" Style="{DynamicResource SmallPrimaryButtonStyle}" 
                               Command="{Binding ExportToCsvCommand}" Height="30" Width="100" Margin="0,0,10,0"/>
                        <Button Content="Export PDF" Style="{DynamicResource SmallDangerButtonStyle}" 
                               Command="{Binding ExportToPdfCommand}" Height="30" Width="100"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Inventory Report -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" 
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                   CornerRadius="8" Padding="20" Margin="0,0,0,15"
                   Visibility="{Binding InventoryReport, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Inventory Report" FontSize="18" FontWeight="SemiBold" 
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

                    <UniformGrid Grid.Row="1" Columns="4">
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Total Medicines" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding InventoryReport.TotalMedicines}" FontSize="20" FontWeight="Bold" 
                                      Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Total Value" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding InventoryReport.TotalInventoryValue, StringFormat:C}" FontSize="20" FontWeight="Bold" 
                                      Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Low Stock" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding InventoryReport.LowStockCount}" FontSize="20" FontWeight="Bold" 
                                      Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Expiring Soon" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding InventoryReport.ExpiringSoonCount}" FontSize="20" FontWeight="Bold" 
                                      Foreground="{DynamicResource ErrorBrush}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Profit Report -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" 
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                   CornerRadius="8" Padding="20" Margin="0,0,0,15"
                   Visibility="{Binding ProfitReport, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Profit Report" FontSize="18" FontWeight="SemiBold" 
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

                    <UniformGrid Grid.Row="1" Columns="4">
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Revenue" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding ProfitReport.TotalRevenue, StringFormat=C}" FontSize="20" FontWeight="Bold" 
                                      Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Cost" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding ProfitReport.TotalCost, StringFormat:C}" FontSize="20" FontWeight="Bold" 
                                      Foreground="{DynamicResource ErrorBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Gross Profit" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding ProfitReport.GrossProfit, StringFormat=C}" FontSize="20" FontWeight="Bold" 
                                      Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Margin %" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding ProfitReport.ProfitMargin, StringFormat=F1}" FontSize="20" FontWeight="Bold" 
                                      Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Expiry Report -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" 
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                   CornerRadius="8" Padding="20" Margin="0,0,0,15"
                   Visibility="{Binding ExpiryReport, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Expiry Report" FontSize="18" FontWeight="SemiBold" 
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Border Background="{DynamicResource ErrorBrush}" CornerRadius="4" Padding="15,8" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="Expired" Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding ExpiryReport.ExpiredCount}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource WarningBrush}" CornerRadius="4" Padding="15,8">
                            <StackPanel>
                                <TextBlock Text="Expiring Soon" Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding ExpiryReport.ExpiringSoonCount}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
