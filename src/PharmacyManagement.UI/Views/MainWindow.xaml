<Window x:Class="PharmacyManagement.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PharmacyManagement.UI.ViewModels"
        xmlns:views="clr-namespace:PharmacyManagement.UI.Views"
        Title="{Binding Title}" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <!-- DataContext is provided by DI in code-behind -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Height="80">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="PHARMACY" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Management System" FontSize="12" Foreground="{DynamicResource AccentBrush}" 
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Button Content="Dashboard" Style="{DynamicResource NavButtonStyle}" 
                           Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"/>
                    <Button Content="Medicines" Style="{DynamicResource NavButtonStyle}" 
                           Command="{Binding NavigateToCommand}" CommandParameter="Medicines"/>
                    <Button Content="Inventory" Style="{DynamicResource NavButtonStyle}" 
                           Command="{Binding NavigateToCommand}" CommandParameter="Inventory"/>
                    <Button Content="Point of Sale" Style="{DynamicResource NavButtonStyle}" 
                           Command="{Binding NavigateToCommand}" CommandParameter="POS"/>
                    <Button Content="Reports" Style="{DynamicResource NavButtonStyle}" 
                           Command="{Binding NavigateToCommand}" CommandParameter="Reports"/>
                    <Button Content="Settings" Style="{DynamicResource NavButtonStyle}" 
                           Command="{Binding NavigateToCommand}" CommandParameter="Settings"/>
                </StackPanel>

                <!-- User Info -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" 
                       BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding CurrentUser.FullName, FallbackValue='Not Logged In'}" 
                                      FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding CurrentUser.Role, FallbackValue=''}" 
                                      Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding ConnectionStatus}" 
                                      Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Row="1" Content="Logout" Style="{DynamicResource DangerButtonStyle}" 
                               Command="{Binding LogoutCommand}" Height="35"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding SelectedViewModel}" 
                       Margin="20">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                    <views:DashboardView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:MedicineViewModel}">
                    <views:MedicineView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                    <views:InventoryView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:POSViewModel}">
                    <views:POSView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                    <views:ReportsView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                    <views:SettingsView/>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>
